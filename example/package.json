{
  "name": "theme-options-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate": "npm run generate:themes && npm run generate:designs",
    "generate:designs": "python3 ../scripts/generate_example_designs.py",
    "generate:themes": "python3 ../scripts/generate_example_themes.py",
    "prebuild": "npm run generate",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "lucide-react": "^1.17.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
}
